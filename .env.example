# --- required ---------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
# Private key (0x-prefixed hex) of the signer. Never commit .env.
# Collateral on Polymarket is pUSD (0xC011a7E1...E82DFB), NOT USDC.e — see README "Funding".
POLYMARKET_PRIVATE_KEY=0x...
# If you funded via polymarket.com, set this to your Polymarket wallet (proxy) address
# and use the private key of the wallet you log in with. Leave empty for a raw EOA.
# POLYMARKET_WALLET=0x...

# --- Jev --------------------------------------------------------------------
JEV_MODEL=typesafe/jev-1.13

# --- researcher (generative model + web search, writes the evidence brief for Jev) ---
RESEARCH_ENABLED=true
# Any OpenRouter chat model. Cheap + strong: deepseek/deepseek-v4-pro-0813, z-ai/glm-5.3,
# qwen/qwen3.8-max-0902, moonshotai/kimi-k3. Or anthropic/claude-sonnet-5 for native search.
RESEARCH_MODEL=deepseek/deepseek-v4-pro-0813
RESEARCH_TTL_HOURS=6
MAX_RESEARCH_PER_RUN=20
RESEARCH_MAX_RESULTS=5
RESEARCH_MAX_CHARS=2500

# --- signal -----------------------------------------------------------------
MIN_EDGE=0.08
MIN_ANSWERABLE=0.70
MIN_CLARITY=2
# Only buy contracts priced in this band (longshot-bias guard)
MIN_TRADE_PRICE=0.10
MAX_TRADE_PRICE=0.90

# --- market filter ----------------------------------------------------------
MIN_LIQUIDITY_USD=5000
MIN_VOLUME_USD=10000
MAX_DAYS_TO_RESOLUTION=60
MAX_SPREAD=0.06
MIN_MARKET_PRICE=0.03
MAX_MARKET_PRICE=0.97

# --- hard caps --------------------------------------------------------------
MAX_USD_PER_TRADE=5
MAX_OPEN_EXPOSURE_USD=50
MAX_TRADES_PER_RUN=3
KELLY_FRACTION=0.25

DRY_RUN=false
DB_PATH=jevymarket.db
LOG_LEVEL=INFO
