# --- required ---------------------------------------------------------------
# TypeSafe official API key for Jev / System One.
TYPESAFE_API_KEY=ts-...
# DeepSeek official API key for the researcher + native web search.
DEEPSEEK_API_KEY=sk-...

# Private key (0x-prefixed hex) of the signer. Never commit .env.
POLYMARKET_PRIVATE_KEY=0x...
# If you funded via polymarket.com, set this to your Polymarket wallet (proxy) address
# and use the private key of the wallet you log in with. Leave empty for a raw EOA.
# POLYMARKET_WALLET=0x...

# --- Jev (TypeSafe official API) -------------------------------------------
JEV_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1

# --- researcher (DeepSeek official Anthropic API + native web search) -------
RESEARCH_ENABLED=true
RESEARCH_MODEL=deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic/v1
# DEEPSEEK_JSON_BASE_URL=https://api.deepseek.com
RESEARCH_TTL_HOURS=6
MAX_RESEARCH_PER_RUN=20
RESEARCH_MAX_SEARCHES=5
RESEARCH_MAX_CHARS=2500

# --- signal -----------------------------------------------------------------
MIN_EDGE=0.08
MIN_ANSWERABLE=0.70
MIN_CLARITY=2
MIN_TRADE_PRICE=0.10
MAX_TRADE_PRICE=0.90

# --- market filter ----------------------------------------------------------
MIN_LIQUIDITY_USD=5000
MIN_VOLUME_USD=10000
MAX_DAYS_TO_RESOLUTION=60
MAX_SPREAD=0.06
MIN_MARKET_PRICE=0.03
MAX_MARKET_PRICE=0.97

# --- hard caps --------------------------------------------------------------
MAX_USD_PER_TRADE=5
MAX_OPEN_EXPOSURE_USD=50
MAX_TRADES_PER_RUN=3
KELLY_FRACTION=0.25

DRY_RUN=false
DB_PATH=jevymarket.db
LOG_LEVEL=INFO
